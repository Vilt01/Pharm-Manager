<Application x:Class="TaskManager.App"
             xmlns:vm="clr-namespace:TaskManager.ViewModels"
             xmlns:v="clr-namespace:TaskManager.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="Views/LoginView.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                <v:AnalyticsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ZaprosViewModels}">
                <v:RequestsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <v:UsersView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>