<Window x:Class="TaskManager.Views.MainWindow"
        xmlns:vm="clr-namespace:TaskManager.ViewModels" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White">
            <StackPanel Margin="10">
                <TextBlock Text ="Меню"
                            FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,0"/>
                
                <Button Content="Главное меню"
                        Command="{Binding NavigateToHomeCommand}"
                        Style="{StaticResource  MaterialDesignFlatButton}"
                        Height="40"/>

                <Button Content="Заявки"
                        Command="{Binding NavigateToRequestionCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="Black"/>
            </StackPanel>
        </Border>
        
        <Border Grid.Column="1" Background="Gray">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
        
    </Grid>
</Window>
