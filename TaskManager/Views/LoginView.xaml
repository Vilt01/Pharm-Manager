<Window x:Class="TaskManager.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:TaskManager.Core.Converters"
        Title="Pharm Manager"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI"
        BorderBrush="#E0E0E0"
        BorderThickness="1">

    <Window.Resources>
        <!-- Конвертеры -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:PasswordVisibilityConverter x:Key="PasswordVisConverter"/>

        <!-- Стиль для TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#10B981"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#10B981"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для PasswordBox -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#10B981"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#10B981"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <StackPanel>
            <!-- Логотип -->
            <Image Source="/Image/pharm2.png" 
                   Width="64" Height="64"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

            <!-- Заголовки -->
            <TextBlock Text="Добро пожаловать"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       Foreground="#111827"/>

            <TextBlock Text="Войдите в Pharm Manager"
                       FontSize="13"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>
            <Label Content="Логин"/>

            <!-- Поле Логин -->
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBox}"
                     Tag="Имя пользователя"/>
            <Label Content="Пароль"/>

            <!-- Поле Пароль с глазиком -->
            <Grid Margin="0,0,0,24" RenderTransformOrigin="0.487,0.596">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Скрытый PasswordBox -->
                <PasswordBox x:Name="UserPasswordBox"
                Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource ModernPasswordBox}"
             Tag="Пароль"/>

                <!-- Видимый TextBox (пароль как текст) -->
                <TextBox Grid.Column="0"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Visibility="{Binding ShowPasswoedrd, Converter={StaticResource BoolToVis}}"
                         Tag="Пароль"/>

                <!-- Кнопка-глазик -->
            </Grid>
            <Button Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=UserPasswordBox}"
                    Height="44"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="Black"
                    Background="#80E27E"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="16,0" Click="Button_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Войти"/>
            </Button>

            <!-- Кнопка Войти -->

            <!-- Ссылка "Забыли пароль?" -->
            <TextBlock Text="Забыли пароль?"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="#6B7280"
                       Cursor="Hand"
                       MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
        </StackPanel>
    </Grid>
</Window>