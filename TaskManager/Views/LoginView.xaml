<Window x:Class="TaskManager.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:TaskManager.ViewModels"
        Title="Farm manager" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" >

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="41*"/>
            <ColumnDefinition Width="760*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" Grid.ColumnSpan="2">
            <StackPanel VerticalAlignment="Center" Margin="80,0,80,0" Height="270">

                <TextBlock Text="Войти в Farm Manager" 
                           FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,40"
                           FontWeight="Light" Foreground="Black"/>

                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Имя пользователя"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,20" FontSize="16" Width="351"/>

                <PasswordBox x:Name="UserPasswordBox"
                             materialDesign:HintAssist.Hint="Пароль"
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             Margin="0,0,0,40" FontSize="16" Width="350"/>

                <Button Content="Войти"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=UserPasswordBox}"
                        Background="#80E27E" BorderBrush="#80E27E" Foreground="Black"
                        Height="50" FontSize="18"
                        materialDesign:ButtonAssist.CornerRadius="25" Width="350"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>